# Database Configuration
DB_USER=postgres
DB_PASSWORD=aegis_secure_password_change_me
DB_NAME=aegis_gateway

# pgAdmin Configuration
PGADMIN_EMAIL=admin@aegis.local
PGADMIN_PASSWORD=pgadmin_password

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana_password

# Logging
RUST_LOG=info

# Scheduler Configuration
SCHEDULER_NODE_ID=node-1
SCHEDULER_CLUSTER_NODES=scheduler:50051

# LLM Backend Configuration
VLLM_MODEL=meta-llama/Llama-2-7b-hf
VLLM_ENDPOINT=http://vllm:8000
CUDA_DEVICES=0

# Redis Configuration
REDIS_URL=redis://redis:6379

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_WORKERS=4

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
